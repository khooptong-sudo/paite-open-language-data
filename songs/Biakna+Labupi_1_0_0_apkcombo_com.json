h, in Ashk should be aj \"ey\" \"\" \"\" \"ej\" // [e] non Jewish, in Ashk should be aj //\"eu\" \"\" \"\" \"(e|o)\" // non Jewish \"y\" \"[ou]\" \"\" \"j\" \"e\" \"\" \"$\" \"(e|)\" \"i\" \"\" \"[aou]\" \"j\" \"y\" \"\" \"[aoeu]\" \"j\" \"y\" \"\" \"\" \"i\" // TRIVIAL \"a\" \"\" \"\" \"a\" \"b\" \"\" \"\" \"b\" \"d\" \"\" \"\" \"d\" \"e\" \"\" \"\" \"e\" \"f\" \"\" \"\" \"f\" \"g\" \"\" \"\" \"g\" \"h\" \"\" \"\" \"h\" \"i\" \"\" \"\" \"i\" \"k\" \"\" \"\" \"k\" \"l\" \"\" \"\" \"l\" \"m\" \"\" \"\" \"m\" \"n\" \"\" \"\" \"n\" \"o\" \"\" \"\" \"o\" \"p\" \"\" \"\" \"p\" \"r\" \"\" \"\" \"r\" \"s\" \"\" \"\" \"s\" \"t\" \"\" \"\" \"t\" \"u\" \"\" \"\" \"u\" \"v\" \"\" \"\" \"v\" \"z\" \"\" \"\" \"z\"",
